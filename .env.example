# Copy to .env (never commit .env). With no key set, the app runs on the free offline mock LLM.
ANTHROPIC_API_KEY=

# auto = Claude when ANTHROPIC_API_KEY is set, otherwise mock. Force with: anthropic | mock
LLM_PROVIDER=auto

# Models per step: a small fast model routes; a stronger model works the tools and writes the answer.
INTENT_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
COLLATE_MODEL=claude-sonnet-5-5

# Spend protection inside the app (the Console workspace limit is the authoritative cap).
BUDGET_USD=5.0
MAX_LLM_CALLS_PER_REQUEST=12
USAGE_LEDGER_PATH=.usage/ledger.json

# Data: folder the agents' repositories read from (default: ./data) and the pinned "today".
# DATA_DIR=./data
TODAY=2026-11-27
